# Legacy monolith (optional during migration)
SAIBM_DB_URL=jdbc:mysql://HOST:3306/DATABASE?useSSL=true&serverTimezone=UTC
SAIBM_DB_USER=LOCAL_DATABASE_USER
SAIBM_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
SAIBM_RECAPTCHA_SITE_KEY=LOCAL_SITE_KEY
SAIBM_RECAPTCHA_SECRET=REPLACE_WITH_SERVER_SECRET
SAIBM_LEGACY_BASE_URL=http://host.docker.internal:8000

# Local platform databases
SAIBM_IAM_DB_NAME=saibm_iam
SAIBM_IAM_DB_USER=saibm_iam
SAIBM_IAM_DB_PASSWORD=LOCAL_IAM_DB_PASSWORD
SAIBM_LIBRO_DB_NAME=saibm_libro
SAIBM_LIBRO_DB_USER=saibm_libro
SAIBM_LIBRO_DB_PASSWORD=LOCAL_LIBRO_DB_PASSWORD
SAIBM_LIBRO_INTERNAL_ADMIN_SECRET=LOCAL_LIBRO_ADMIN_SECRET
SAIBM_INVENTARIO_DB_NAME=saibm_inventario
SAIBM_INVENTARIO_DB_USER=saibm_inventario
SAIBM_INVENTARIO_DB_PASSWORD=LOCAL_INVENTARIO_DB_PASSWORD
SAIBM_INVENTARIO_INTERNAL_ADMIN_SECRET=LOCAL_INVENTARIO_ADMIN_SECRET
SAIBM_MEMBRESIA_DB_NAME=saibm_membresia
SAIBM_MEMBRESIA_DB_USER=saibm_membresia
SAIBM_MEMBRESIA_DB_PASSWORD=LOCAL_MEMBRESIA_DB_PASSWORD
SAIBM_MEMBRESIA_INTERNAL_ADMIN_SECRET=LOCAL_MEMBRESIA_ADMIN_SECRET
SAIBM_USUARIO_DB_NAME=saibm_usuario
SAIBM_USUARIO_DB_USER=saibm_usuario
SAIBM_USUARIO_DB_PASSWORD=LOCAL_USUARIO_DB_PASSWORD
SAIBM_USUARIO_INTERNAL_ADMIN_SECRET=LOCAL_USUARIO_ADMIN_SECRET
SAIBM_CIRCULATION_DB_NAME=saibm_circulation
SAIBM_CIRCULATION_DB_USER=saibm_circulation
SAIBM_CIRCULATION_DB_PASSWORD=LOCAL_CIRCULATION_DB_PASSWORD
SAIBM_REPORTING_DB_NAME=saibm_reporting
SAIBM_REPORTING_DB_USER=saibm_reporting
SAIBM_REPORTING_DB_PASSWORD=LOCAL_REPORTING_DB_PASSWORD

# Local messaging and future IAM contract
SAIBM_RABBITMQ_USER=saibm_local
SAIBM_RABBITMQ_PASSWORD=LOCAL_RABBITMQ_PASSWORD
SAIBM_RABBITMQ_VHOST=saibm
SAIBM_JWT_SECRET=LOCAL_ONLY_256_BIT_MINIMUM_SECRET
SAIBM_JWT_ISSUER=http://localhost:8081
SAIBM_JWT_AUDIENCE=saibm-api
SAIBM_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Explicit opt-in legacy read-only backfill; keep disabled for normal startup
SAIBM_USUARIO_BACKFILL_ENABLED=false
SAIBM_LEGACY_DB_URL=jdbc:mysql://HOST:3306/DATABASE?useSSL=true&serverTimezone=UTC
SAIBM_LEGACY_DB_USER=READ_ONLY_LEGACY_USER
SAIBM_LEGACY_DB_PASSWORD=REPLACE_WITH_READ_ONLY_PASSWORD
